<Project Sdk="Microsoft.NET.Sdk">

  <!-- batonctl: the command line of Baton. It only talks to the running app through Baton.Protocol; tools\build-packages.ps1
       publishes it self-contained, single-file and trimmed (about 13 MB). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>batonctl</AssemblyName>
    <Version>1.4.0</Version>
    <RootNamespace>Baton.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationIcon>..\Baton.App\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Baton.Protocol\Baton.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Baton.Tests" />
  </ItemGroup>

</Project>
