<Window x:Class="DownloadManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Connessioni per download (1–32)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="ConnectionsBox" AutomationProperties.Name="Connessioni per download" Width="100" HorizontalAlignment="Left" />

        <TextBlock Text="Download simultanei avviati dalla coda (1–20)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ConcurrentBox" AutomationProperties.Name="Download simultanei" Width="100" HorizontalAlignment="Left" />

        <TextBlock Text="Limite di velocità globale in KB/s (0 = nessun limite)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="LimitBox" AutomationProperties.Name="Limite velocità" Width="100" HorizontalAlignment="Left" />

        <TextBlock Text="Cartella predefinita dei download" Style="{StaticResource FieldLabel}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Sfoglia…" Style="{StaticResource DialogButton}" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" AutomationProperties.Name="Cartella predefinita" />
        </DockPanel>

        <CheckBox x:Name="ConfirmBrowserBox" Margin="0,14,0,0" AutomationProperties.Name="Chiedi conferma per i download dal browser"
                  Content="Chiedi conferma per i download inviati dall'estensione del browser" />

        <TextBlock Text="Il numero di connessioni vale per i download avviati dopo il salvataggio." Foreground="{StaticResource MutedBrush}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Salva" Style="{StaticResource PrimaryButton}" Click="OnSave" IsDefault="True" />
            <Button Content="Annulla" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
