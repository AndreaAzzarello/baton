<Window x:Class="DownloadManager.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DownloadManager.Core.Resources;assembly=DownloadManager.Core"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" Icon="/app.ico">
    <StackPanel Margin="22">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="26" Margin="0,2,16,0"
                       VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" />
            <StackPanel>
                <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                <TextBlock x:Name="Details" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Warning" Style="{StaticResource ErrorText}" />
        <CheckBox x:Name="PlainBox" Content="{x:Static r:Strings.LoginPlainConfirm}" Margin="0,8,0,0" Visibility="Collapsed"
                  Checked="OnPlainChanged" Unchecked="OnPlainChanged" />

        <Label Content="{x:Static r:Strings.LoginUserLabel}" Target="{Binding ElementName=UserBox}" Padding="0" Margin="0,16,0,4" Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="UserBox" AutomationProperties.Name="{x:Static r:Strings.LoginUserName}" />
        <Label Content="{x:Static r:Strings.LoginPasswordLabel}" Target="{Binding ElementName=PasswordBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{x:Static r:Strings.LoginPasswordName}" />
        <CheckBox x:Name="RememberBox" Content="{x:Static r:Strings.LoginRemember}" Margin="0,12,0,0" ToolTip="{x:Static r:Strings.LoginRememberToolTip}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SignInButton" Content="{x:Static r:Strings.LoginSignIn}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
            <Button Content="{x:Static r:Strings.Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
