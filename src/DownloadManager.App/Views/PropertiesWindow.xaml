<Window x:Class="DownloadManager.App.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DownloadManager.Core.Resources;assembly=DownloadManager.Core"
        Title="{x:Static r:Strings.PropertiesTitle}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />

        <Label Content="{x:Static r:Strings.PropertiesUrlLabel}" Target="{Binding ElementName=UrlBox}" Padding="0" Margin="0,14,0,4" Foreground="{DynamicResource MutedBrush}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.UpdateUrl}" Style="{StaticResource DialogButton}" Command="{Binding UpdateUrlCommand}"
                    ToolTip="{x:Static r:Strings.UpdateUrlToolTip}" />
            <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCompleted}"
                     AutomationProperties.Name="{x:Static r:Strings.PropertiesUrlName}" />
        </DockPanel>
        <TextBlock Text="{Binding Message}" Style="{StaticResource NoteText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Content="{x:Static r:Strings.PropertiesCategory}" Target="{Binding ElementName=CategoryBox}" Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,2,0,6" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding Category}" DisplayMemberPath="Name" AutomationProperties.Name="{x:Static r:Strings.PropertiesCategory}" />

            <TextBlock Grid.Row="1" Text="{x:Static r:Strings.PropertiesFolder}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <DockPanel Grid.Row="1" Grid.Column="1">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" MinWidth="0" Padding="6,2" Command="{Binding OpenFolderCommand}"
                        AutomationProperties.Name="{x:Static r:Strings.MenuOpenFolder}" ToolTip="{x:Static r:Strings.MenuOpenFolder}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14" />
                </Button>
                <TextBlock Text="{Binding Folder}" Style="{StaticResource ValueText}" />
            </DockPanel>

            <TextBlock Grid.Row="2" Text="{x:Static r:Strings.PropertiesStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="3" Text="{x:Static r:Strings.PropertiesSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="4" Text="{x:Static r:Strings.PropertiesDownloaded}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DownloadedText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="5" Text="{x:Static r:Strings.PropertiesResumable}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ResumableText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="6" Text="{x:Static r:Strings.PropertiesType}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ContentTypeText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="7" Text="{x:Static r:Strings.PropertiesETag}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ETagText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="8" Text="{x:Static r:Strings.PropertiesLastModified}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LastModifiedText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="9" Text="{x:Static r:Strings.PropertiesAdded}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding AddedText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="10" Text="{x:Static r:Strings.PropertiesCompleted}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding CompletedText}" Style="{StaticResource ValueText}" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static r:Strings.Close}" Style="{StaticResource PrimaryButton}" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
