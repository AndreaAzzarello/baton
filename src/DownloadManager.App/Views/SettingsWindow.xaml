<Window x:Class="DownloadManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DownloadManager.Core.Resources;assembly=DownloadManager.Core"
        Title="{x:Static r:Strings.SettingsTitle}" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static r:Strings.SettingsDownloads}" Style="{StaticResource SectionTitle}" />
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static r:Strings.SettingsConnections}" Target="{Binding ElementName=ConnectionsBox}" VerticalAlignment="Center" Padding="0" Foreground="{DynamicResource MutedBrush}" />
            <TextBox x:Name="ConnectionsBox" Grid.Column="1" Margin="0,4" Text="{Binding Connections}" AutomationProperties.Name="{x:Static r:Strings.SettingsConnections}" />
            <Label Grid.Row="1" Content="{x:Static r:Strings.SettingsConcurrent}" Target="{Binding ElementName=ConcurrentBox}" VerticalAlignment="Center" Padding="0" Foreground="{DynamicResource MutedBrush}" />
            <TextBox x:Name="ConcurrentBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Concurrent}" AutomationProperties.Name="{x:Static r:Strings.SettingsConcurrent}" />
            <Label Grid.Row="2" Content="{x:Static r:Strings.SettingsSpeedLimit}" Target="{Binding ElementName=LimitBox}" VerticalAlignment="Center" Padding="0" Foreground="{DynamicResource MutedBrush}" />
            <TextBox x:Name="LimitBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding SpeedLimit}" AutomationProperties.Name="{x:Static r:Strings.SettingsSpeedLimit}" />
            <Label Grid.Row="3" Content="{x:Static r:Strings.SettingsGlobalQuota}" Target="{Binding ElementName=QuotaBox}" VerticalAlignment="Center" Padding="0" Foreground="{DynamicResource MutedBrush}" />
            <TextBox x:Name="QuotaBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding GlobalQuota}" AutomationProperties.Name="{x:Static r:Strings.SettingsGlobalQuota}" />
        </Grid>

        <Label Content="{x:Static r:Strings.SettingsFolder}" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Browse}" Style="{StaticResource DialogButton}" Command="{Binding BrowseCommand}" />
            <TextBox x:Name="FolderBox" Text="{Binding Folder}" AutomationProperties.Name="{x:Static r:Strings.SettingsFolder}" />
        </DockPanel>
        <TextBlock Text="{x:Static r:Strings.SettingsFolderHint}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

        <TextBlock Text="{x:Static r:Strings.SettingsAppearance}" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{x:Static r:Strings.SettingsTheme}">
            <RadioButton Content="{x:Static r:Strings.ThemeSystem}" IsChecked="{Binding ThemeSystem}" GroupName="Theme" Margin="0,0,20,0" />
            <RadioButton Content="{x:Static r:Strings.ThemeLight}" IsChecked="{Binding ThemeLight}" GroupName="Theme" Margin="0,0,20,0" />
            <RadioButton Content="{x:Static r:Strings.ThemeDark}" IsChecked="{Binding ThemeDark}" GroupName="Theme" />
        </StackPanel>

        <TextBlock Text="{x:Static r:Strings.SettingsIntegration}" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
        <CheckBox Content="{x:Static r:Strings.SettingsConfirmBrowser}" IsChecked="{Binding ConfirmBrowserDownloads}" Margin="0,2" />
        <CheckBox Content="{x:Static r:Strings.SettingsNotify}" IsChecked="{Binding NotifyOnCompletion}" Margin="0,2" />

        <TextBlock Text="{x:Static r:Strings.SettingsSystem}" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
        <CheckBox Content="{x:Static r:Strings.SettingsRunAtStartup}" IsChecked="{Binding RunAtStartup}" Margin="0,2" />
        <CheckBox Content="{x:Static r:Strings.SettingsCloseToTray}" IsChecked="{Binding CloseToTray}" Margin="0,2" />

        <TextBlock Text="{x:Static r:Strings.SettingsConnectionsHint}" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static r:Strings.Save}" Style="{StaticResource PrimaryButton}" Click="OnSave" IsDefault="True" />
            <Button Content="{x:Static r:Strings.Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
