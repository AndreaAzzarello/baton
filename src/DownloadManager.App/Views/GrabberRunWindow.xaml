<Window x:Class="DownloadManager.App.Views.GrabberRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DownloadManager.Core.Resources;assembly=DownloadManager.Core"
        xmlns:v="clr-namespace:DownloadManager.App.Views"
        Title="{Binding Title}" Width="1080" Height="760" MinWidth="720" MinHeight="460"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="/app.ico">
    <Window.Resources>
        <v:SelectedTextConverter x:Key="SelectedText" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading and progress -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Command="{Binding StopCommand}" VerticalAlignment="Top"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{x:Static r:Strings.GrabberStop}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static r:Strings.GrabberStop}" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding Project.StartUrl}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <ProgressBar Height="4" IsIndeterminate="{Binding IsRunning, Mode=OneWay}" Minimum="0" Maximum="1" Value="1" BorderThickness="0"
                             Foreground="{DynamicResource ProgressFillBrush}" Background="{DynamicResource TrackBrush}" Margin="0,0,0,8" Focusable="False"
                             AutomationProperties.Name="{x:Static r:Strings.GrabberProgressName}" />
                <TextBlock Text="{Binding ProgressText}" AutomationProperties.LiveSetting="Off" />
                <TextBlock Text="{Binding CurrentText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Filters -->
        <Grid Grid.Row="2" Margin="0,14,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="{x:Static r:Strings.GrabberFilterLabel}" Target="{Binding ElementName=FilterBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="{x:Static r:Strings.BatchFilterName}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{x:Static r:Strings.BatchTypeLabel}" Target="{Binding ElementName=TypeBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="TypeBox" ItemsSource="{Binding Extensions}" SelectedItem="{Binding Extension}" DisplayMemberPath="Label"
                          AutomationProperties.Name="{x:Static r:Strings.BatchTypeName}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="{x:Static r:Strings.GrabberStatusLabel}" Target="{Binding ElementName=StatusBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="StatusBox" ItemsSource="{Binding StatusFilters}" SelectedIndex="{Binding StatusFilter}"
                          AutomationProperties.Name="{x:Static r:Strings.GrabberStatusName}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsFiles, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="{x:Static r:Strings.BatchSelectVisible}" Style="{StaticResource DialogButton}" Command="{Binding SelectVisibleCommand}" Margin="0,0,8,0" />
                    <Button Content="{x:Static r:Strings.BatchClearVisible}" Style="{StaticResource DialogButton}" Command="{Binding ClearVisibleCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>

            <DataGrid x:Name="List" Grid.Row="1" ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" RowHeight="30"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="False"
                      AutomationProperties.Name="{x:Static r:Strings.GrabberListName}" AutomationProperties.HelpText="{x:Static r:Strings.BatchListHelp}"
                      PreviewKeyDown="OnListKeyDown" MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                        <Setter Property="Padding" Value="10,8,4,8" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding StatusText}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="CheckColumn" Width="44" CanUserSort="True" SortMemberPath="IsSelected">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" Focusable="False"
                                          AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static r:Strings.ColumnName}" Binding="{Binding Name}" Width="2*" MinWidth="160" IsReadOnly="True" />
                    <DataGridTextColumn Header="{x:Static r:Strings.BatchColumnType}" Binding="{Binding Extension}" Width="64" IsReadOnly="True" />
                    <DataGridTextColumn Header="{x:Static r:Strings.ColumnSize}" Binding="{Binding SizeText}" SortMemberPath="SizeSort" Width="104" IsReadOnly="True" />
                    <DataGridTextColumn Header="{x:Static r:Strings.ColumnStatus}" Binding="{Binding StatusText}" SortMemberPath="Status" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="{x:Static r:Strings.GrabberColumnSource}" Binding="{Binding SourcePage}" Width="*" MinWidth="120" IsReadOnly="True" />
                    <DataGridTextColumn x:Name="LocalColumn" Header="{x:Static r:Strings.GrabberColumnLocal}" Binding="{Binding LocalPath}" Width="*" MinWidth="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="{x:Static r:Strings.BatchColumnUrl}" Binding="{Binding Url}" Width="2*" MinWidth="160" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Destination (files) -->
        <Grid Grid.Row="4" Margin="0,14,0,0" Visibility="{Binding IsFiles, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="{x:Static r:Strings.AddCategoryLabel}" Target="{Binding ElementName=CategoryBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static r:Strings.AddCategoryName}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{x:Static r:Strings.AddQueueLabel}" Target="{Binding ElementName=QueueBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="QueueBox" ItemsSource="{Binding Queues}" SelectedItem="{Binding Queue}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static r:Strings.AddQueueName}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="{x:Static r:Strings.BatchFolderLabel}" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Browse}" Style="{StaticResource DialogButton}" Command="{Binding BrowseCommand}" />
                    <TextBox x:Name="FolderBox" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:Strings.AddFolderName}"
                             ToolTip="{x:Static r:Strings.BatchFolderToolTip}" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock Text="{Binding FolderError}" Style="{StaticResource ErrorText}" Margin="0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsFiles, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="{x:Static r:Strings.AddToQueue}" Style="{StaticResource DialogButton}" Command="{Binding SendCommand}" CommandParameter="false" />
                    <Button Content="{x:Static r:Strings.AddStartNow}" Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" CommandParameter="true" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMirror, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="{x:Static r:Strings.GrabberOpenFolder}" Style="{StaticResource DialogButton}" Command="{Binding OpenFolderCommand}" />
                    <Button Content="{x:Static r:Strings.GrabberOpenCopy}" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCopyCommand}" />
                </StackPanel>
                <Button Content="{x:Static r:Strings.Close}" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
