<Window x:Class="DownloadManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DownloadManager.Core.Resources;assembly=DownloadManager.Core"
        xmlns:vm="clr-namespace:DownloadManager.App.ViewModels"
        Title="{x:Static r:Strings.AppName}" Height="640" Width="1280" MinWidth="800" MinHeight="380"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" Icon="/app.ico"
        AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" Drop="OnDrop">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFind" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionAdd}" ToolTip="{x:Static r:Strings.ActionAddToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{x:Static r:Strings.ActionAdd}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Separator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding StartCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionStart}" ToolTip="{x:Static r:Strings.ActionStartToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" /><TextBlock Text="{x:Static r:Strings.ActionStart}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionPause}" ToolTip="{x:Static r:Strings.ActionPauseToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" /><TextBlock Text="{x:Static r:Strings.ActionPause}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding EnqueueCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionEnqueue}" ToolTip="{x:Static r:Strings.ActionEnqueueToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" /><TextBlock Text="{x:Static r:Strings.ActionEnqueue}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RemoveCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionRemove}" ToolTip="{x:Static r:Strings.ActionRemoveToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" /><TextBlock Text="{x:Static r:Strings.ActionRemove}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ProgressCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionProgress}" ToolTip="{x:Static r:Strings.ActionProgressToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" /><TextBlock Text="{x:Static r:Strings.ActionProgress}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PropertiesCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionProperties}" ToolTip="{x:Static r:Strings.ActionPropertiesToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" /><TextBlock Text="{x:Static r:Strings.ActionProperties}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Separator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding MoveUpCommand}" MinWidth="44" AutomationProperties.Name="{x:Static r:Strings.ActionUp}" ToolTip="{x:Static r:Strings.ActionUpToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" /><TextBlock Text="{x:Static r:Strings.ActionUp}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding MoveDownCommand}" MinWidth="44" AutomationProperties.Name="{x:Static r:Strings.ActionDown}" ToolTip="{x:Static r:Strings.ActionDownToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" /><TextBlock Text="{x:Static r:Strings.ActionDown}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Separator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleQueueCommand}" MinWidth="92"
                        AutomationProperties.Name="{Binding QueueText}" ToolTip="{Binding QueueToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="{Binding QueueGlyph}" /><TextBlock Text="{Binding QueueText}" Margin="0,3,0,0" /></StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding SettingsCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionSettings}" ToolTip="{x:Static r:Strings.ActionSettings}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" /><TextBlock Text="{x:Static r:Strings.ActionSettings}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding QueuesCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionQueues}" ToolTip="{x:Static r:Strings.ActionQueuesToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" /><TextBlock Text="{x:Static r:Strings.ActionQueues}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding CategoriesCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionCategories}" ToolTip="{x:Static r:Strings.ActionCategoriesToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" /><TextBlock Text="{x:Static r:Strings.ActionCategories}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding OpenDownloadFolderCommand}" AutomationProperties.Name="{x:Static r:Strings.ActionFolder}" ToolTip="{x:Static r:Strings.ActionFolderToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" /><TextBlock Text="{x:Static r:Strings.ActionFolder}" Margin="0,3,0,0" /></StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="210" MinWidth="150" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side panel: status filters, each narrowed by category -->
            <Border Background="{DynamicResource SurfaceAltBrush}">
                <TreeView x:Name="NavigationTree" ItemsSource="{Binding Navigation}" Background="Transparent" BorderThickness="0" Padding="6,10"
                          AllowDrop="True" DragOver="OnTreeDragOver" Drop="OnTreeDrop"
                          AutomationProperties.Name="{x:Static r:Strings.NavigationName}" KeyboardNavigation.TabNavigation="Once">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="ContextMenu" Value="{Binding NavigationMenu, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:NavigationNodeViewModel}" ItemsSource="{Binding Children}">
                            <DockPanel Margin="0,2" MinWidth="120">
                                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="14"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding Detail}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Focusable="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{DynamicResource SurfaceAltBrush}">
                            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BorderBrush}" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- List header: current filter and search -->
            <Grid Grid.Column="2" Margin="16,12,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding ShowStartupWarning, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.EnableStartup}" Style="{StaticResource DialogButton}"
                                    Command="{Binding EnableStartupCommand}" />
                            <TextBlock Text="{x:Static r:Strings.StartupWarning}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>
                    <Grid DockPanel.Dock="Right" Width="280">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,30,6"
                                 AutomationProperties.Name="{x:Static r:Strings.SearchName}" ToolTip="{x:Static r:Strings.SearchToolTip}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="{x:Static r:Strings.SearchPlaceholder}" Margin="31,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <DataGrid x:Name="Grid" Grid.Row="1" ItemsSource="{Binding ItemsView}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="None" CanUserResizeRows="False" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True"
                          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          RowHeight="36" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static r:Strings.ListName}"
                          SelectionChanged="OnSelectionChanged" Sorting="OnSorting" MouseDoubleClick="OnRowDoubleClick"
                          PreviewMouseLeftButtonDown="OnGridMouseDown" PreviewMouseMove="OnGridMouseMove"
                          ColumnReordered="OnColumnsChanged">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding DefaultActionCommand}" />
                        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding PropertiesCommand}" />
                        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="Padding" Value="10,8,4,8" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="ContextMenu" Value="{Binding ColumnMenu, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding StatusText}" />
                            <Setter Property="ContextMenu" Value="{Binding RowMenu, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{x:Static r:Strings.ColumnName}" SortMemberPath="Name" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding StatusGlyph}" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnSize}" SortMemberPath="SizeSort" Binding="{Binding SizeText}" Width="112" />
                        <DataGridTemplateColumn Header="{x:Static r:Strings.ColumnProgress}" SortMemberPath="Progress" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Foreground="{DynamicResource ProgressFillBrush}"
                                                     Background="{DynamicResource TrackBrush}" BorderThickness="0" Focusable="False"
                                                     AutomationProperties.Name="{Binding ProgressText}" />
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnSpeed}" SortMemberPath="Speed" Binding="{Binding SpeedText}" Width="96" />
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnRemaining}" SortMemberPath="RemainingSort" Binding="{Binding EtaText}" Width="128" />
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnConnections}" SortMemberPath="Connections" Binding="{Binding ConnectionsText}" Width="78" />
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnStatus}" SortMemberPath="StatusSort" Binding="{Binding StatusText}" Width="115" />
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnCategory}" SortMemberPath="CategoryName" Binding="{Binding CategoryName}" Width="110" />
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnQueue}" SortMemberPath="QueueName" Binding="{Binding QueueName}" Width="130" Visibility="Collapsed" />
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnAdded}" SortMemberPath="AddedUtc" Binding="{Binding AddedText}" Width="130" />
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnCompleted}" SortMemberPath="CompletedUtc" Binding="{Binding CompletedText}" Width="130" Visibility="Collapsed" />
                        <DataGridTextColumn Header="{x:Static r:Strings.ColumnFolder}" SortMemberPath="Directory" Binding="{Binding Directory}" Width="200" Visibility="Collapsed" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource EmptyGlyphBrush}" />
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyHint}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock Text="{Binding SpeedText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
