<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DownloadManager.Core\DownloadManager.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DownloadManager</AssemblyName>
    <RootNamespace>DownloadManager.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <Product>DownloadManager</Product>
    <Description>Segmented download manager with pause/resume and queue</Description>
    <!-- Program.Main decides between the app and the browser's native messaging host -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>DownloadManager.App.Program</StartupObject>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 produces one self-contained exe -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
