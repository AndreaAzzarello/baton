<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DownloadManager.Core\DownloadManager.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK projection gives access to toast notifications -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DownloadManager</AssemblyName>
    <RootNamespace>DownloadManager.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <Product>DownloadManager</Product>
    <Description>Segmented download manager with pause/resume and queue</Description>
    <!-- Program.Main decides between the app and the browser's native messaging host -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>DownloadManager.App.Program</StartupObject>
    <!-- Application.ThemeMode (Fluent light/dark theme) is marked experimental in .NET 10 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 produces one self-contained exe -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not compressed: a compressed bundle is unpacked into memory at every start (+125 MB of RAM for an app that stays open) -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
