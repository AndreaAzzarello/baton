<Window x:Class="DownloadManager.App.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiungi download" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Indirizzo (URL)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="UrlBox" AutomationProperties.Name="Indirizzo" TextChanged="OnInputChanged" />

        <TextBlock Text="Salva nella cartella" Style="{StaticResource FieldLabel}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Sfoglia…" Style="{StaticResource DialogButton}" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" AutomationProperties.Name="Cartella" TextChanged="OnInputChanged" />
        </DockPanel>

        <TextBlock Text="Nome file (facoltativo: lasciare vuoto per usare quello del server)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" AutomationProperties.Name="Nome file" />

        <TextBlock x:Name="NoteText" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="QueueButton" Content="Aggiungi alla coda" Style="{StaticResource DialogButton}" Click="OnQueue" />
            <Button x:Name="StartButton" Content="Scarica ora" Style="{StaticResource PrimaryButton}" Click="OnStartNow" IsDefault="True" />
            <Button Content="Annulla" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
