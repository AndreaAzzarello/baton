<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Baton.Core\Baton.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK projection gives access to toast notifications -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Baton</AssemblyName>
    <RootNamespace>Baton.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.3.4</Version>
    <Product>Baton</Product>
    <Description>Baton - a fast segmented download manager for Windows</Description>
    <Copyright>Copyright (c) 2026 Andrea Azzarello</Copyright>
    <!-- Program.Main decides between the app and the browser's native messaging host -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Baton.App.Program</StartupObject>
    <!-- Application.ThemeMode (Fluent light/dark theme) is marked experimental in .NET 10 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- The languages of the interface: framework and package messages in other languages are left out -->
    <SatelliteResourceLanguages>en;it</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 produces one self-contained exe -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not compressed: a compressed bundle is unpacked into memory at every start (+125 MB of RAM for an app that stays open) -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <InternalsVisibleTo Include="Baton.UiTests" />
  </ItemGroup>

</Project>
