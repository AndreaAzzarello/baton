<Window x:Class="Baton.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:Baton.Core.Resources;assembly=Baton.Core"
        xmlns:l="clr-namespace:Baton.App.Services"
        xmlns:vm="clr-namespace:Baton.App.ViewModels"
        xmlns:c="clr-namespace:Baton.App.Controls"
        Title="{l:Loc AppName}" Height="640" Width="1280" MinWidth="800" MinHeight="380"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" Icon="/app.ico"
        AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" Drop="OnDrop">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding GrabberCommand}" />
        <KeyBinding Key="Delete" Modifiers="Control+Shift" Command="{Binding ClearCompletedCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFind" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel x:Name="ToolbarPanel" LastChildFill="False">
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddCommand}" Tag="add" AutomationProperties.Name="{l:Loc ActionAdd}" ToolTip="{l:Loc ActionAddToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{l:Loc ActionAdd}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Separator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding StartCommand}" Tag="start" AutomationProperties.Name="{l:Loc ActionStart}" ToolTip="{l:Loc ActionStartToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" /><TextBlock Text="{l:Loc ActionStart}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" Tag="pause" AutomationProperties.Name="{l:Loc ActionPause}" ToolTip="{l:Loc ActionPauseToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" /><TextBlock Text="{l:Loc ActionPause}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding EnqueueCommand}" Tag="enqueue" AutomationProperties.Name="{l:Loc ActionEnqueue}" ToolTip="{l:Loc ActionEnqueueToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" /><TextBlock Text="{l:Loc ActionEnqueue}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RemoveCommand}" Tag="remove" AutomationProperties.Name="{l:Loc ActionRemove}" ToolTip="{l:Loc ActionRemoveToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" /><TextBlock Text="{l:Loc ActionRemove}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteFilesCommand}" Tag="deletefiles" AutomationProperties.Name="{l:Loc ActionDeleteFiles}" ToolTip="{l:Loc ActionDeleteFilesToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE107;" /><TextBlock Text="{l:Loc ActionDeleteFiles}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ClearCompletedCommand}" Tag="clearcompleted" AutomationProperties.Name="{l:Loc ActionClearCompleted}" ToolTip="{l:Loc ActionClearCompletedToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE75C;" /><TextBlock Text="{l:Loc ActionClearCompleted}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ProgressCommand}" Tag="progress" AutomationProperties.Name="{l:Loc ActionProgress}" ToolTip="{l:Loc ActionProgressToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" /><TextBlock Text="{l:Loc ActionProgress}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PropertiesCommand}" Tag="properties" AutomationProperties.Name="{l:Loc ActionProperties}" ToolTip="{l:Loc ActionPropertiesToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" /><TextBlock Text="{l:Loc ActionProperties}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Separator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding MoveUpCommand}" Tag="up" MinWidth="44" AutomationProperties.Name="{l:Loc ActionUp}" ToolTip="{l:Loc ActionUpToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" /><TextBlock Text="{l:Loc ActionUp}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding MoveDownCommand}" Tag="down" MinWidth="44" AutomationProperties.Name="{l:Loc ActionDown}" ToolTip="{l:Loc ActionDownToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" /><TextBlock Text="{l:Loc ActionDown}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Separator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleQueueCommand}" Tag="queue" MinWidth="92"
                        AutomationProperties.Name="{Binding QueueText}" ToolTip="{Binding QueueToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="{Binding QueueGlyph}" /><TextBlock Text="{Binding QueueText}" Margin="0,3,0,0" /></StackPanel>
                </Button>

                <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnMore" MinWidth="44"
                        AutomationProperties.Name="{l:Loc ActionMore}" ToolTip="{l:Loc ActionMoreToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" /><TextBlock Text="{l:Loc ActionMore}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SettingsCommand}" Tag="settings" AutomationProperties.Name="{l:Loc ActionSettings}" ToolTip="{l:Loc ActionSettings}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" /><TextBlock Text="{l:Loc ActionSettings}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding GrabberCommand}" Tag="grabber" AutomationProperties.Name="{l:Loc ActionGrabber}" ToolTip="{l:Loc ActionGrabberToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" /><TextBlock Text="{l:Loc ActionGrabber}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding QueuesCommand}" Tag="queues" AutomationProperties.Name="{l:Loc ActionQueues}" ToolTip="{l:Loc ActionQueuesToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" /><TextBlock Text="{l:Loc ActionQueues}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CategoriesCommand}" Tag="categories" AutomationProperties.Name="{l:Loc ActionCategories}" ToolTip="{l:Loc ActionCategoriesToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" /><TextBlock Text="{l:Loc ActionCategories}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenDownloadFolderCommand}" Tag="folder" AutomationProperties.Name="{l:Loc ActionFolder}" ToolTip="{l:Loc ActionFolderToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" /><TextBlock Text="{l:Loc ActionFolder}" Margin="0,3,0,0" /></StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="210" MinWidth="150" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side panel: status filters, each narrowed by category -->
            <Border Background="{DynamicResource SurfaceAltBrush}">
                <TreeView x:Name="NavigationTree" ItemsSource="{Binding Navigation}" Background="Transparent" BorderThickness="0" Padding="6,10"
                          AllowDrop="True" DragOver="OnTreeDragOver" Drop="OnTreeDrop"
                          AutomationProperties.Name="{l:Loc NavigationName}" KeyboardNavigation.TabNavigation="Once">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="ContextMenu" Value="{Binding NavigationMenu, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:NavigationNodeViewModel}" ItemsSource="{Binding Children}">
                            <DockPanel Margin="0,2" MinWidth="120">
                                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="14"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding Detail}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Focusable="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{DynamicResource SurfaceAltBrush}">
                            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BorderBrush}" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- List header: current filter and search -->
            <Grid Grid.Column="2" Margin="16,12,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding ShowStartupWarning, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc EnableStartup}" Style="{StaticResource DialogButton}"
                                    Command="{Binding EnableStartupCommand}" />
                            <TextBlock Text="{l:Loc StartupWarning}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>
                    <Grid DockPanel.Dock="Right" Width="280">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,30,6"
                                 AutomationProperties.Name="{l:Loc SearchName}" ToolTip="{l:Loc SearchToolTip}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="{l:Loc SearchPlaceholder}" Margin="31,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <DataGrid x:Name="Grid" Grid.Row="1" ItemsSource="{Binding ItemsView}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="None" CanUserResizeRows="False" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True"
                          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          RowHeight="36" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{l:Loc ListName}"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="OnSelectionChanged" Sorting="OnSorting" MouseDoubleClick="OnRowDoubleClick"
                          c:ListSelection.IsEnabled="True"
                          ColumnReordered="OnColumnsChanged">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeleteFilesCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding DefaultActionCommand}" />
                        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding PropertiesCommand}" />
                        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="Padding" Value="10,8,4,8" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="ContextMenu" Value="{Binding ColumnMenu, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource ListCell}" />
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ListRow}">
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding StatusText}" />
                            <Setter Property="ContextMenu" Value="{Binding RowMenu, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:Loc ColumnName}" SortMemberPath="Name" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding StatusGlyph}" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:Loc ColumnSize}" SortMemberPath="SizeSort" Binding="{Binding SizeText}" Width="112" />
                        <DataGridTemplateColumn Header="{l:Loc ColumnProgress}" SortMemberPath="Progress" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Foreground="{DynamicResource ProgressFillBrush}"
                                                     Background="{DynamicResource TrackBrush}" BorderThickness="0" Focusable="False"
                                                     AutomationProperties.Name="{Binding ProgressText}" />
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:Loc ColumnSpeed}" SortMemberPath="Speed" Binding="{Binding SpeedText}" Width="96" />
                        <DataGridTextColumn Header="{l:Loc ColumnRemaining}" SortMemberPath="RemainingSort" Binding="{Binding EtaText}" Width="128" />
                        <DataGridTextColumn Header="{l:Loc ColumnConnections}" SortMemberPath="Connections" Binding="{Binding ConnectionsText}" Width="78" />
                        <DataGridTextColumn Header="{l:Loc ColumnStatus}" SortMemberPath="StatusSort" Binding="{Binding StatusText}" Width="115" />
                        <DataGridTextColumn Header="{l:Loc ColumnCategory}" SortMemberPath="CategoryName" Binding="{Binding CategoryName}" Width="110" />
                        <DataGridTextColumn Header="{l:Loc ColumnQueue}" SortMemberPath="QueueName" Binding="{Binding QueueName}" Width="130" Visibility="Collapsed" />
                        <DataGridTextColumn Header="{l:Loc ColumnAdded}" SortMemberPath="AddedUtc" Binding="{Binding AddedText}" Width="165" MinWidth="150" />
                        <DataGridTextColumn Header="{l:Loc ColumnCompleted}" SortMemberPath="CompletedUtc" Binding="{Binding CompletedText}" Width="165" MinWidth="150" Visibility="Collapsed" />
                        <DataGridTextColumn Header="{l:Loc ColumnFolder}" SortMemberPath="Directory" Binding="{Binding Directory}" Width="200" Visibility="Collapsed" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource EmptyGlyphBrush}" />
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyHint}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock Text="{Binding SpeedText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding SelectionText}" DockPanel.Dock="Right" Margin="0,0,24,0" Foreground="{DynamicResource TextBrush}"
                           ToolTip="{Binding SelectionToolTip}" AutomationProperties.HelpText="{Binding SelectionToolTip}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
