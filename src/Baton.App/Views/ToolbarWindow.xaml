<Window x:Class="Baton.App.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc ToolbarTitle}" Width="460" Height="560" MinWidth="380" MinHeight="420"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc ToolbarHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox Content="{l:Loc ToolbarSmallIcons}" IsChecked="{Binding SmallIcons}" Margin="0,2" />
            <CheckBox Content="{l:Loc ToolbarShowText}" IsChecked="{Binding ShowText}" Margin="0,2" />
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Content="{l:Loc ToolbarReset}" Style="{StaticResource DialogButton}" Margin="0" Command="{Binding ResetCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Loc Save}" Style="{StaticResource PrimaryButton}" Click="OnSave" IsDefault="True" />
                    <Button Content="{l:Loc Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
            <Button Content="{l:Loc ActionUp}" Style="{StaticResource DialogButton}" Margin="0,0,0,6" Command="{Binding MoveUpCommand}"
                    AutomationProperties.Name="{l:Loc ToolbarMoveUp}" />
            <Button Content="{l:Loc ActionDown}" Style="{StaticResource DialogButton}" Margin="0,0,0,6" Command="{Binding MoveDownCommand}"
                    AutomationProperties.Name="{l:Loc ToolbarMoveDown}" />
            <Button Content="{l:Loc ToolbarAddSeparator}" Style="{StaticResource DialogButton}" Margin="0" Command="{Binding AddSeparatorCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:Loc ToolbarTitle}" PreviewKeyDown="OnListKey"
                 Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Visible}" IsEnabled="{Binding CanHide}" Focusable="False" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
