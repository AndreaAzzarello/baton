<Window x:Class="Baton.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <DockPanel>
            <TextBlock x:Name="IconGlyph" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="28" Margin="0,0,16,0"
                       VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="20" />
        </DockPanel>
        <Expander x:Name="DetailsPanel" Margin="44,16,0,0" Visibility="Collapsed" Header="{l:Loc ErrorDetails}"
                  AutomationProperties.Name="{l:Loc ErrorDetails}">
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="NoWrap" MaxHeight="220" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas"
                     FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{l:Loc ErrorDetails}" />
        </Expander>
        <DockPanel Margin="0,24,0,0">
            <Button x:Name="CopyDetails" DockPanel.Dock="Left" Content="{l:Loc ErrorCopyDetails}" Style="{StaticResource DialogButton}"
                    Margin="0" Visibility="Collapsed" Click="OnCopyDetails" />
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
        </DockPanel>
        <TextBlock x:Name="CopiedText" Style="{StaticResource NoteText}" HorizontalAlignment="Left" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</Window>
