<Window x:Class="Baton.App.Views.GrabberProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc GrabberProjectsTitle}" Width="980" Height="520" MinWidth="680" MinHeight="360"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Icon="/app.ico">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Command="{Binding NewCommand}" AutomationProperties.Name="{l:Loc GrabberNew}" ToolTip="{l:Loc GrabberNewToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{l:Loc GrabberNew}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Separator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding RunCommand}" AutomationProperties.Name="{l:Loc GrabberRun}" ToolTip="{l:Loc GrabberRunToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" /><TextBlock Text="{l:Loc GrabberRun}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding EditCommand}" AutomationProperties.Name="{l:Loc GrabberEdit}" ToolTip="{l:Loc GrabberEditToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" /><TextBlock Text="{l:Loc GrabberEdit}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenFolderCommand}" AutomationProperties.Name="{l:Loc GrabberOpenFolder}" ToolTip="{l:Loc GrabberOpenFolderToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" /><TextBlock Text="{l:Loc ActionFolder}" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" AutomationProperties.Name="{l:Loc GrabberDelete}" ToolTip="{l:Loc GrabberDeleteToolTip}">
                    <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" /><TextBlock Text="{l:Loc GrabberDelete}" Margin="0,3,0,0" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,0">
            <DataGrid x:Name="List" ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" RowHeight="44"
                      AutomationProperties.Name="{l:Loc GrabberProjectsName}" MouseDoubleClick="OnDoubleClick">
                <DataGrid.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RunCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                    <KeyBinding Key="F2" Command="{Binding EditCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                        <Setter Property="Padding" Value="10,8,4,8" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ListCell}" />
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ListRow}">
                        <Setter Property="ToolTip" Value="{Binding LastResult}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding State}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:Loc GrabberColumnProject}" SortMemberPath="Name" Width="2*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Loc GrabberColumnMode}" Binding="{Binding ModeText}" Width="120" />
                    <DataGridTextColumn Header="{l:Loc ColumnStatus}" Binding="{Binding State}" Width="110" />
                    <DataGridTextColumn Header="{l:Loc GrabberColumnLastRun}" Binding="{Binding LastRunText}" Width="130" />
                    <DataGridTextColumn Header="{l:Loc GrabberColumnResult}" Binding="{Binding LastResult}" Width="2*" MinWidth="160" />
                    <DataGridTextColumn Header="{l:Loc GrabberColumnNextRun}" Binding="{Binding NextText}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource EmptyGlyphBrush}" />
                <TextBlock Text="{l:Loc GrabberEmptyTitle}" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" />
                <TextBlock Text="{l:Loc GrabberEmptyHint}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="460" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="16,12,16,16">
            <Button DockPanel.Dock="Right" Content="{l:Loc Close}" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnClose" />
            <TextBlock Text="{l:Loc GrabberProjectsHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
