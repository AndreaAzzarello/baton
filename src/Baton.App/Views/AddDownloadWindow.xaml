<Window x:Class="Baton.App.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc AddTitle}" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/app.ico">
    <StackPanel Margin="20">
        <Label Content="{l:Loc AddUrlLabel}" Target="{Binding ElementName=UrlBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding UrlReadOnly, Mode=OneTime}" AutomationProperties.Name="{l:Loc AddUrlName}" />

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="{l:Loc AddCategoryLabel}" Target="{Binding ElementName=CategoryBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="{l:Loc AddCategoryName}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{l:Loc AddQueueLabel}" Target="{Binding ElementName=QueueBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="QueueBox" ItemsSource="{Binding Queues}" SelectedItem="{Binding Queue}" DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="{l:Loc AddQueueName}" ToolTip="{l:Loc AddQueueToolTip}" />
            </StackPanel>
        </Grid>

        <Label Content="{l:Loc AddNameLabel}" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="NameBox" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc AddNameName}"
                 ToolTip="{l:Loc AddNameToolTip}" />

        <Label Content="{l:Loc AddFolderLabel}" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{l:Loc Browse}" Style="{StaticResource DialogButton}" Command="{Binding BrowseCommand}" />
            <TextBox x:Name="FolderBox" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc AddFolderName}" />
        </DockPanel>

        <Label Content="{l:Loc AddHashLabel}" Target="{Binding ElementName=HashBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="HashBox" Text="{Binding ExpectedHash, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                 AutomationProperties.Name="{l:Loc AddHashName}" AutomationProperties.HelpText="{Binding HashHint}" />
        <TextBlock Text="{Binding HashHint}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" />

        <TextBlock Text="{Binding Note}" Style="{StaticResource NoteText}" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Loc AddToQueue}" Style="{StaticResource DialogButton}" Click="OnQueue" IsEnabled="{Binding CanSubmit}" />
            <Button Content="{l:Loc AddStartNow}" Style="{StaticResource PrimaryButton}" Click="OnStartNow" IsDefault="True" IsEnabled="{Binding CanSubmit}" />
            <Button Content="{l:Loc Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
