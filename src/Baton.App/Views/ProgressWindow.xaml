<Window x:Class="Baton.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        xmlns:c="clr-namespace:Baton.App.Controls"
        Title="{Binding Title}" Width="620" Height="520" MinWidth="480" MinHeight="420"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" Icon="/app.ico">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnClose" />
    </Window.CommandBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Item.Name}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Name}" />
            <TextBlock Text="{Binding Item.Url}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Url}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Loc ProgressStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,12,3" />
            <TextBlock Grid.Column="1" Text="{Binding Item.StatusText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Column="2" Text="{l:Loc ProgressSpeed}" Foreground="{DynamicResource MutedBrush}" Margin="16,3,12,3" />
            <TextBlock Grid.Column="3" Text="{Binding Item.SpeedText}" Style="{StaticResource ValueText}" />

            <TextBlock Grid.Row="1" Text="{l:Loc ProgressDownloaded}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,12,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DownloadedText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:Loc ProgressRemaining}" Foreground="{DynamicResource MutedBrush}" Margin="16,3,12,3" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Item.EtaText}" Style="{StaticResource ValueText}" />

            <TextBlock Grid.Row="2" Text="{l:Loc ProgressResumable}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,12,3" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResumableText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{l:Loc ProgressConnectionsLabel}" Foreground="{DynamicResource MutedBrush}" Margin="16,3,12,3" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ConnectionsText}" Style="{StaticResource ValueText}" />
        </Grid>

        <ProgressBar Grid.Row="2" Height="8" Margin="0,16,0,0" Minimum="0" Maximum="100" Value="{Binding Item.Progress, Mode=OneWay}"
                     IsIndeterminate="{Binding Item.IsIndeterminate, Mode=OneWay}" AutomationProperties.Name="{l:Loc ProgressOverall}" />

        <StackPanel Grid.Row="3" Margin="0,18,0,8">
            <TextBlock Text="{l:Loc ProgressMap}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
            <c:SegmentBar Segments="{Binding Segments}" TotalSize="{Binding TotalSize}" Height="28"
                          TrackBrush="{DynamicResource TrackBrush}" DoneBrush="{DynamicResource SegmentDoneBrush}"
                          ActiveBrush="{DynamicResource SegmentActiveBrush}" BoundaryBrush="{DynamicResource SurfaceBrush}"
                          AutomationProperties.Name="{Binding ConnectionsText}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Rectangle Width="12" Height="12" Fill="{DynamicResource SegmentDoneBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc LegendDone}" Margin="6,0,16,0" Foreground="{DynamicResource MutedBrush}" />
                <Rectangle Width="3" Height="14" Fill="{DynamicResource SegmentActiveBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc LegendActive}" Margin="6,0,16,0" Foreground="{DynamicResource MutedBrush}" />
                <Rectangle Width="12" Height="12" Fill="{DynamicResource TrackBrush}" Stroke="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc LegendMissing}" Margin="6,0,0,0" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="None" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single"
                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  AutomationProperties.Name="{l:Loc ProgressConnectionsList}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                <DataGridTextColumn Header="{l:Loc SegmentRange}" Binding="{Binding Range}" Width="*" />
                <DataGridTextColumn Header="{l:Loc SegmentDownloaded}" Binding="{Binding Downloaded}" Width="100" />
                <DataGridTemplateColumn Header="{l:Loc SegmentProgress}" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center" Focusable="False" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Loc SegmentState}" Binding="{Binding State}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:Loc MenuOpen}" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}"
                    Visibility="{Binding Item.IsCompleted, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{l:Loc MenuOpenFolder}" Style="{StaticResource DialogButton}" Command="{Binding RevealCommand}" />
            <Button Content="{Binding ToggleText}" Style="{StaticResource DialogButton}" Command="{Binding ToggleCommand}" />
            <Button Content="{l:Loc Close}" Style="{StaticResource DialogButton}" Command="{x:Static ApplicationCommands.Close}" />
        </StackPanel>
    </Grid>
</Window>
