<Window x:Class="Baton.App.Views.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc DuplicateTitle}" Width="620" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" LineHeight="20" />
        <TextBlock Text="{l:Loc DuplicateExisting}" Margin="0,14,0,2" Opacity="0.7" />
        <TextBlock Text="{Binding ExistingName}" FontWeight="SemiBold" TextWrapping="Wrap"
                   AutomationProperties.Name="{l:Loc DuplicateExisting}" />
        <TextBlock Text="{Binding ExistingFolder}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Opacity="0.7"
                   ToolTip="{Binding ExistingFolder}" />
        <CheckBox x:Name="RememberBox" Content="{l:Loc DuplicateRemember}" IsChecked="{Binding Remember}" Margin="0,16,0,0" />
        <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Content="{l:Loc DuplicateAddAnyway}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnAddAnyway" />
            <Button Content="{l:Loc DuplicateOverwrite}" Style="{StaticResource DialogButton}" Click="OnOverwrite"
                    Visibility="{Binding CanOverwrite, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{l:Loc DuplicateOpen}" Style="{StaticResource DialogButton}" Click="OnOpen"
                    IsEnabled="{Binding CanOpen}" />
            <Button Content="{l:Loc DuplicateSkip}" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnSkip" />
        </WrapPanel>
    </StackPanel>
</Window>
