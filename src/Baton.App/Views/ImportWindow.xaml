<Window x:Class="Baton.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc ImportTitle}" Width="720" Height="560" MinWidth="520" MinHeight="380"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{l:Loc ImportDuplicatesLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{l:Loc ImportDuplicatesLabel}">
                <RadioButton Content="{l:Loc ImportModeSkip}" IsChecked="{Binding ModeSkip}" GroupName="Mode" Margin="0,0,20,0" />
                <RadioButton Content="{l:Loc ImportModeReplace}" IsChecked="{Binding ModeReplace}" GroupName="Mode" Margin="0,0,20,0"
                             ToolTip="{l:Loc ImportModeReplaceToolTip}" />
                <RadioButton Content="{l:Loc ImportModeKeepBoth}" IsChecked="{Binding ModeKeepBoth}" GroupName="Mode" />
            </StackPanel>
            <TextBlock Text="{l:Loc ImportHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{l:Loc ImportApply}" Style="{StaticResource PrimaryButton}" Click="OnImport" IsDefault="True" />
                <Button Content="{l:Loc Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Rows}" AutomationProperties.Name="{l:Loc ImportTitle}" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Include}" IsEnabled="{Binding CanInclude}" VerticalAlignment="Top" Margin="0,2,8,0"
                                  AutomationProperties.Name="{Binding}" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding KindText}" Width="90" Foreground="{DynamicResource MutedBrush}" Margin="0,2,8,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding Item.Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Item.Detail}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Note}" Style="{StaticResource NoteText}" Margin="0" />
                            <TextBlock Text="{Binding Warning}" Style="{StaticResource ErrorText}" Margin="0,2,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
