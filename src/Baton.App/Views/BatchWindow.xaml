<Window x:Class="Baton.App.Views.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        xmlns:c="clr-namespace:Baton.App.Controls"
        xmlns:v="clr-namespace:Baton.App.Views"
        Title="{l:Loc BatchTitle}" Width="860" Height="620" MinWidth="620" MinHeight="420"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="/app.ico">
    <Window.Resources>
        <v:SelectedTextConverter x:Key="SelectedText" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:Loc BatchHeading}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding PageTitle}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                       ToolTip="{Binding Request.PageUrl}" />
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="{l:Loc BatchFilterLabel}" Target="{Binding ElementName=FilterBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         AutomationProperties.Name="{l:Loc BatchFilterName}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{l:Loc BatchTypeLabel}" Target="{Binding ElementName=TypeBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="TypeBox" ItemsSource="{Binding Extensions}" SelectedItem="{Binding Extension}" DisplayMemberPath="Label"
                          AutomationProperties.Name="{l:Loc BatchTypeName}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="{l:Loc BatchKindLabel}" Target="{Binding ElementName=KindBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="KindBox" SelectedIndex="{Binding Kind}" AutomationProperties.Name="{l:Loc BatchKindName}">
                    <ComboBoxItem Content="{l:Loc BatchKindAll}" />
                    <ComboBoxItem Content="{l:Loc BatchKindLinks}" />
                    <ComboBoxItem Content="{l:Loc BatchKindImages}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,8">
            <Button Content="{l:Loc BatchSelectVisible}" Style="{StaticResource DialogButton}" Command="{Binding SelectVisibleCommand}" Margin="0,0,8,0" />
            <Button Content="{l:Loc BatchClearVisible}" Style="{StaticResource DialogButton}" Command="{Binding ClearVisibleCommand}" />
            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"
                       AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <DataGrid x:Name="List" c:ListSelection.IsEnabled="True" Grid.Row="3" ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False"
                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" RowHeight="32"
                  AutomationProperties.Name="{l:Loc BatchListName}" AutomationProperties.HelpText="{l:Loc BatchListHelp}"
                  PreviewKeyDown="OnListKeyDown">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter Property="Padding" Value="10,8,4,8" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource ListCell}" />
                <Style TargetType="DataGridRow" BasedOn="{StaticResource ListRow}">
                    <Setter Property="ToolTip" Value="{Binding Url}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="{Binding IsSelected, Converter={StaticResource SelectedText}}" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="44" CanUserSort="True" SortMemberPath="IsSelected">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Focusable="False"
                                      AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Loc ColumnName}" Binding="{Binding Name}" Width="2*" MinWidth="160" IsReadOnly="True" />
                <DataGridTextColumn Header="{l:Loc BatchColumnType}" Binding="{Binding Extension}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="{l:Loc BatchColumnKind}" Binding="{Binding KindText}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="{l:Loc BatchColumnText}" Binding="{Binding Text}" Width="*" MinWidth="100" IsReadOnly="True" />
                <DataGridTextColumn Header="{l:Loc BatchColumnUrl}" Binding="{Binding Url}" Width="2*" MinWidth="160" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Destination -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="{l:Loc AddCategoryLabel}" Target="{Binding ElementName=CategoryBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{l:Loc AddCategoryName}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{l:Loc AddQueueLabel}" Target="{Binding ElementName=QueueBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="QueueBox" ItemsSource="{Binding Queues}" SelectedItem="{Binding Queue}" DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="{l:Loc AddQueueName}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="{l:Loc BatchFolderLabel}" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Loc Browse}" Style="{StaticResource DialogButton}" Command="{Binding BrowseCommand}" />
                    <TextBox x:Name="FolderBox" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc AddFolderName}"
                             ToolTip="{l:Loc BatchFolderToolTip}" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Loc AddToQueue}" Style="{StaticResource DialogButton}" Click="OnQueue" IsEnabled="{Binding CanSubmit}" />
                <Button Content="{l:Loc AddStartNow}" Style="{StaticResource PrimaryButton}" Click="OnStartNow" IsDefault="True" IsEnabled="{Binding CanSubmit}" />
                <Button Content="{l:Loc Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
