<Window x:Class="Baton.App.Views.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc CategoriesTitle}" Width="720" Height="470" MinWidth="600" MinHeight="400"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource DialogButton}" Margin="0" MinWidth="0" Command="{Binding AddCommand}" AutomationProperties.Name="{l:Loc CategoryAdd}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="{l:Loc CategoryAdd}" /></StackPanel>
                </Button>
                <Button Style="{StaticResource DialogButton}" MinWidth="0" Command="{Binding DeleteCommand}" AutomationProperties.Name="{l:Loc CategoryDelete}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="{l:Loc CategoryDelete}" /></StackPanel>
                </Button>
            </StackPanel>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"
                     AutomationProperties.Name="{l:Loc CategoriesListName}"
                     Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
        </DockPanel>

        <StackPanel Grid.Column="2" DataContext="{Binding Selected}">
            <Label Content="{l:Loc CategoryNameLabel}" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc CategoryNameName}" />

            <Label Content="{l:Loc CategoryExtensionsLabel}" Target="{Binding ElementName=ExtensionsBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
            <TextBox x:Name="ExtensionsBox" Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"
                     MinHeight="64" VerticalContentAlignment="Top" AutomationProperties.Name="{l:Loc CategoryExtensionsName}" />
            <TextBlock Text="{l:Loc CategoryExtensionsHint}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

            <Label Content="{l:Loc CategoryFolderLabel}" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Loc Browse}" Style="{StaticResource DialogButton}"
                        Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBox x:Name="FolderBox" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc CategoryFolderName}" />
            </DockPanel>
            <TextBlock Text="{l:Loc CategoryGeneralHint}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:Loc Save}" Style="{StaticResource PrimaryButton}" Click="OnSave" IsDefault="True" />
                <Button Content="{l:Loc Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
        </DockPanel>
    </Grid>
</Window>
