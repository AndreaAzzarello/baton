<Window x:Class="Baton.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc FirstRunTitle}" Width="680" Height="700" MinWidth="520" MinHeight="480"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc FirstRunIntro}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:Loc FirstRunFinish}" Style="{StaticResource PrimaryButton}" Click="OnFinish" IsDefault="True" />
            <Button Content="{l:Loc FirstRunSkip}" Style="{StaticResource DialogButton}" IsCancel="True" ToolTip="{l:Loc FirstRunSkipToolTip}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{l:Loc FirstRunFolderTitle}" Style="{StaticResource SectionTitle}" />
                <Label Content="{l:Loc SettingsFolder}" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,6,0,4" Foreground="{DynamicResource MutedBrush}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Loc Browse}" Style="{StaticResource DialogButton}" Command="{Binding BrowseCommand}" />
                    <TextBox x:Name="FolderBox" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc SettingsFolder}" />
                </DockPanel>
                <TextBlock Text="{l:Loc FirstRunCategoriesHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,6" />
                <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Label DockPanel.Dock="Left" Width="140" Content="{Binding Name}" Target="{Binding ElementName=CategoryBox}" Padding="0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                <TextBox x:Name="CategoryBox" Text="{Binding Folder}" AutomationProperties.Name="{Binding Name}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l:Loc FirstRunBrowsersTitle}" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
                <TextBlock Text="{l:Loc FirstRunNoBrowsers}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           Visibility="{Binding NoBrowsers, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Browsers}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:Loc FirstRunCopyPage}" Style="{StaticResource DialogButton}" Command="{Binding CopyPageCommand}"
                                            AutomationProperties.Name="{Binding CopyPageName}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Instructions}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{l:Loc FirstRunOpenExtensionFolder}" Style="{StaticResource DialogButton}" Margin="0" Command="{Binding OpenExtensionFolderCommand}" />
                    <Button Content="{l:Loc FirstRunVerify}" Style="{StaticResource DialogButton}" Command="{Binding VerifyCommand}" ToolTip="{l:Loc FirstRunVerifyToolTip}" />
                </StackPanel>
                <TextBlock Text="{Binding Connection}" Style="{StaticResource NoteText}" AutomationProperties.LiveSetting="Polite" />

                <TextBlock Text="{l:Loc SettingsSystem}" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
                <CheckBox Content="{l:Loc SettingsRunAtStartup}" IsChecked="{Binding StartWithWindows}" Margin="0,2" />
                <TextBlock Text="{l:Loc SettingsAppearance}" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
                <StackPanel Orientation="Horizontal" AutomationProperties.Name="{l:Loc SettingsTheme}">
                    <RadioButton Content="{l:Loc ThemeSystem}" IsChecked="{Binding ThemeSystem}" GroupName="Theme" Margin="0,0,20,0" />
                    <RadioButton Content="{l:Loc ThemeLight}" IsChecked="{Binding ThemeLight}" GroupName="Theme" Margin="0,0,20,0" />
                    <RadioButton Content="{l:Loc ThemeDark}" IsChecked="{Binding ThemeDark}" GroupName="Theme" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
