<Window x:Class="Baton.App.Views.ClearCompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc ClearCompletedTitle}" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <StackPanel Visibility="{Binding HasScope, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12"
                    AutomationProperties.Name="{l:Loc ClearCompletedScopeName}">
            <RadioButton x:Name="OnlyScopeButton" Content="{Binding OnlyScopeText}" IsChecked="{Binding OnlyScope}" GroupName="Scope" Margin="0,2" />
            <RadioButton Content="{l:Loc ClearCompletedAll}" IsChecked="{Binding AllScope}" GroupName="Scope" Margin="0,2" />
        </StackPanel>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="20" AutomationProperties.LiveSetting="Polite" />
        <CheckBox x:Name="RecycleBox" Content="{l:Loc ClearCompletedRecycle}" IsChecked="{Binding MoveToRecycleBin}" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{l:Loc ClearCompletedConfirm}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" IsEnabled="{Binding CanConfirm}" />
            <Button Content="{l:Loc Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
