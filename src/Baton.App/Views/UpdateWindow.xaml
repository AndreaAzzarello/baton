<Window x:Class="Baton.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:Baton.Core.Resources;assembly=Baton.Core"
        Title="{x:Static r:Strings.UpdateTitle}" Width="520" Height="440" MinWidth="420" MinHeight="320"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
        <Label DockPanel.Dock="Top" Content="{x:Static r:Strings.UpdateNotes}" Target="{Binding ElementName=NotesBox}" Padding="0" Margin="0,10,0,4"
               Foreground="{DynamicResource MutedBrush}" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Focusable="False"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{x:Static r:Strings.UpdateDownloading}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource NoteText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{x:Static r:Strings.UpdateInstall}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" IsDefault="True" />
                <Button Content="{x:Static r:Strings.UpdateLater}" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="NotesBox" Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static r:Strings.UpdateNotes}" />
    </DockPanel>
</Window>
