<Window x:Class="Baton.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc UpdateTitle}" Width="520" Height="440" MinWidth="420" MinHeight="320"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
        <Label DockPanel.Dock="Top" Content="{l:Loc UpdateNotes}" Target="{Binding ElementName=NotesBox}" Padding="0" Margin="0,10,0,4"
               Foreground="{DynamicResource MutedBrush}" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Focusable="False"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{l:Loc UpdateDownloading}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource NoteText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{l:Loc UpdateInstall}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" IsDefault="True" />
                <Button Content="{l:Loc UpdateLater}" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="NotesBox" Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{l:Loc UpdateNotes}" />
    </DockPanel>
</Window>
