<Window x:Class="Baton.App.Views.CertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc CertificateTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" Icon="/app.ico">
    <StackPanel Margin="22">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="28" Margin="0,2,16,0"
                       VerticalAlignment="Top" Foreground="{DynamicResource DangerBrush}" />
            <StackPanel>
                <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                <TextBlock x:Name="Problems" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Loc CertificateSubject}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock x:Name="Subject" Grid.Column="1" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="1" Text="{l:Loc CertificateIssuer}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock x:Name="Issuer" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="2" Text="{l:Loc CertificateValidity}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock x:Name="Validity" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="3" Text="{l:Loc CertificateFingerprint}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBox x:Name="Fingerprint" Grid.Row="3" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                     AutomationProperties.Name="{l:Loc CertificateFingerprint}" />
        </Grid>
        <TextBlock Text="{l:Loc CertificateAdvice}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Loc CertificateAcceptAlways}" Style="{StaticResource DialogButton}" Click="OnAlways" />
            <Button Content="{l:Loc CertificateAcceptOnce}" Style="{StaticResource DialogButton}" Click="OnOnce" />
            <Button x:Name="RejectButton" Content="{l:Loc CertificateReject}" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="OnReject" />
        </StackPanel>
    </StackPanel>
</Window>
