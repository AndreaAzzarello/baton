<Window x:Class="Baton.App.Views.CertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:Baton.Core.Resources;assembly=Baton.Core"
        Title="{x:Static r:Strings.CertificateTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" Icon="/app.ico">
    <StackPanel Margin="22">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="28" Margin="0,2,16,0"
                       VerticalAlignment="Top" Foreground="{DynamicResource DangerBrush}" />
            <StackPanel>
                <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                <TextBlock x:Name="Problems" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static r:Strings.CertificateSubject}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock x:Name="Subject" Grid.Column="1" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="1" Text="{x:Static r:Strings.CertificateIssuer}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock x:Name="Issuer" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="2" Text="{x:Static r:Strings.CertificateValidity}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock x:Name="Validity" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="3" Text="{x:Static r:Strings.CertificateFingerprint}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBox x:Name="Fingerprint" Grid.Row="3" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                     AutomationProperties.Name="{x:Static r:Strings.CertificateFingerprint}" />
        </Grid>
        <TextBlock Text="{x:Static r:Strings.CertificateAdvice}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static r:Strings.CertificateAcceptAlways}" Style="{StaticResource DialogButton}" Click="OnAlways" />
            <Button Content="{x:Static r:Strings.CertificateAcceptOnce}" Style="{StaticResource DialogButton}" Click="OnOnce" />
            <Button x:Name="RejectButton" Content="{x:Static r:Strings.CertificateReject}" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="OnReject" />
        </StackPanel>
    </StackPanel>
</Window>
