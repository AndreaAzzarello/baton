<Window x:Class="Baton.App.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc PropertiesTitle}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />

        <Label Content="{l:Loc PropertiesUrlLabel}" Target="{Binding ElementName=UrlBox}" Padding="0" Margin="0,14,0,4" Foreground="{DynamicResource MutedBrush}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{l:Loc UpdateUrl}" Style="{StaticResource DialogButton}" Command="{Binding UpdateUrlCommand}"
                    ToolTip="{l:Loc UpdateUrlToolTip}" />
            <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCompleted}"
                     AutomationProperties.Name="{l:Loc PropertiesUrlName}" />
        </DockPanel>
        <TextBlock Text="{Binding Message}" Style="{StaticResource NoteText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Content="{l:Loc PropertiesCategory}" Target="{Binding ElementName=CategoryBox}" Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,2,0,6" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding Category}" DisplayMemberPath="DisplayName" AutomationProperties.Name="{l:Loc PropertiesCategory}" />

            <TextBlock Grid.Row="1" Text="{l:Loc PropertiesFolder}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <DockPanel Grid.Row="1" Grid.Column="1">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" MinWidth="0" Padding="6,2" Command="{Binding OpenFolderCommand}"
                        AutomationProperties.Name="{l:Loc MenuOpenFolder}" ToolTip="{l:Loc MenuOpenFolder}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14" />
                </Button>
                <TextBlock Text="{Binding Folder}" Style="{StaticResource ValueText}" />
            </DockPanel>

            <TextBlock Grid.Row="2" Text="{l:Loc PropertiesStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="3" Text="{l:Loc PropertiesSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="4" Text="{l:Loc PropertiesDownloaded}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DownloadedText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="5" Text="{l:Loc PropertiesResumable}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ResumableText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="6" Text="{l:Loc PropertiesType}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ContentTypeText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="7" Text="{l:Loc PropertiesETag}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ETagText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="8" Text="{l:Loc PropertiesLastModified}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LastModifiedText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="9" Text="{l:Loc PropertiesAdded}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding AddedText}" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="10" Text="{l:Loc PropertiesCompleted}" Foreground="{DynamicResource MutedBrush}" Margin="0,3" />
            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding CompletedText}" Style="{StaticResource ValueText}" />
        </Grid>

        <!-- Checks after the download: hash and antivirus -->
        <TextBlock Text="{l:Loc CheckHeading}" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" AutomationProperties.HeadingLevel="Level2" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{l:Loc CheckExpectedLabel}" Target="{Binding ElementName=ExpectedBox}" Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <DockPanel Grid.Column="1" Margin="0,2">
                <Button DockPanel.Dock="Right" Content="{l:Loc CheckVerify}" Style="{StaticResource DialogButton}" Command="{Binding VerifyCommand}" />
                <TextBox x:Name="ExpectedBox" Text="{Binding ExpectedHash, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                         AutomationProperties.Name="{l:Loc AddHashName}" />
            </DockPanel>

            <TextBlock Grid.Row="1" Text="{l:Loc CheckResultLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HashResultText}" Margin="0,6,0,3" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HashProblem}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Label Grid.Row="2" Content="{l:Loc CheckHashLabel}" Target="{Binding ElementName=AlgorithmBox}" Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                <ComboBox x:Name="AlgorithmBox" DockPanel.Dock="Left" Width="110" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}"
                          IsEnabled="{Binding CanChooseAlgorithm}" AutomationProperties.Name="{l:Loc CheckAlgorithmName}" />
                <Button DockPanel.Dock="Right" Content="{l:Loc CheckCopyHash}" Style="{StaticResource DialogButton}" Command="{Binding CopyHashCommand}" />
                <TextBox Text="{Binding ComputedHashText, Mode=OneWay}" IsReadOnly="True" Margin="8,0,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                         VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc CheckComputedName}" />
            </DockPanel>

            <TextBlock Grid.Row="3" Text="{l:Loc ScanLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,3" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ScanText}" Margin="0,6,0,3" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ScanProblem}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <TextBlock Text="{Binding HashMessage}" Style="{StaticResource NoteText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Loc Close}" Style="{StaticResource PrimaryButton}" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
