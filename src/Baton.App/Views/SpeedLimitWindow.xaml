<Window x:Class="Baton.App.Views.SpeedLimitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Baton.App.Services"
        Title="{l:Loc SpeedCustomTitle}" Width="380" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" Icon="/app.ico">
    <StackPanel Margin="20">
        <Label Content="{l:Loc SpeedCustomLabel}" Target="{Binding ElementName=ValueBox}" Padding="0" Margin="0,0,0,4"
               Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="ValueBox" AutomationProperties.Name="{l:Loc SpeedCustomName}" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Loc Ok}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
            <Button Content="{l:Loc Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
